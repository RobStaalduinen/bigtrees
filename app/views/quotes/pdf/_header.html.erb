<%# Masthead for page 1. Carries the ONLY copy of the company's contact
    details in the document — the old repeated block at the foot is gone. %>
<table class='masthead'>
  <tr>
    <td>
      <% if organization.id == 2 %>
        <img src='https://bigtreecare.s3.amazonaws.com/public/ShadowRiverLogo.JPG' class='shadow-river-logo'>
      <% elsif organization.id == 1 %>
        <img src='https://bigtreecare.s3.amazonaws.com/public/LogoHorizontal.png' class='pdf_header-image'>
      <% elsif organization.logo_url.present? %>
        <img src="<%= organization.logo_url %>" class='pdf-logo'>
      <% else %>
        <div class='pdf-logo-name'><%= organization.legal_name || organization.name %></div>
      <% end %>
    </td>

    <td class='company-block'>
      <span class='company-name'><%= organization.legal_name || organization.name %></span>
      <%= [organization.address&.street,
           organization.address&.city,
           organization.address&.postal_code].compact_blank.join(', ') %>
      <% contact = [organization.phone_number, organization.email].compact_blank %>
      <% if contact.any? %>
        <br><%= contact.join(' &nbsp; ').html_safe %>
      <% end %>
      <% if organization.website.present? %>
        <br><%= organization.website %>
      <% end %>
    </td>
  </tr>
</table>
<div class='masthead-rule'></div>

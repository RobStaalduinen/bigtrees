<% estimate ||= @estimate %>
<% organization ||= estimate.organization %>
<% compressed_view ||= false %>

<%# One template serves all three documents; the title is the only switch. %>
<% document_title =
     if estimate.invoice&.number.present? && estimate.invoice.paid?
       "Receipt for Invoice ##{estimate.invoice.number}"
     elsif estimate.invoice&.number.present?
       "Invoice ##{estimate.invoice.number}"
     else
       'Quote'
     end %>

<div class='alwaysbreak page'>
  <%= render 'quotes/pdf/quote',
             estimate: estimate,
             organization: organization,
             document_title: document_title,
             compressed_view: compressed_view %>
</div>

<%# Invoices and receipts never carry the extra pages; beyond that each
    organization chooses which ones its quotes include (Quote Customization in
    My Company). No quote_settings record means all three, which is how quotes
    behaved before the setting existed. %>
<% unless compressed_view %>
  <% if organization.include_quote_image_page? %>
    <%= render 'quotes/pdf/images',
               estimate: estimate,
               organization: organization,
               document_title: document_title %>
  <% end %>

  <% if organization.include_quote_pre_job_page? %>
    <div class='alwaysbreak page'>
      <%= render 'quotes/pdf/details',
                 organization: organization,
                 estimate: estimate,
                 document_title: document_title %>
    </div>
  <% end %>

  <% if organization.include_quote_terms? %>
    <div class='alwaysbreak page'>
      <%= render 'quotes/pdf/terms',
                 organization: organization,
                 estimate: estimate,
                 document_title: document_title %>
    </div>
  <% end %>
<% end %>

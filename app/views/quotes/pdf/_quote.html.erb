<% date_tendered = estimate&.invoice&.sent_at.presence || Date.today %>

<%# All three are optional. Each section is omitted when empty rather than
    rendered as a bare heading — these go to customers, and an empty
    "Scope of work" heading reads as broken rather than as not-yet-filled-in. %>
<% quote_scope   = estimate.quote_scope %>
<% scope_of_work = quote_scope&.scope_of_work %>
<% inclusions    = quote_scope&.inclusions || [] %>
<% exclusions    = quote_scope&.exclusions || [] %>

<%# With no scope block between the parties panel and the pricing, the top of
    the page reads as cramped. Open it up in that case only — when the scope
    sections ARE present they supply the separation themselves, and the extra
    space would cost a dense quote its one-page fit. %>
<% scope_present = scope_of_work.present? || inclusions.any? || exclusions.any? %>


<%= render 'quotes/pdf/header', organization: organization %>

<table class='title-block <%= 'spacious' unless scope_present %>'>
  <tr>
    <td>
      <h1 class='doc-title'><%= document_title %></h1>
    </td>
    <td class='doc-meta'>
      <table>
        <tr>
          <td class='k'>Date tendered</td>
          <td class='v'><%= date_tendered.strftime('%d %B %Y') %></td>
        </tr>
        <% if estimate.work_completion_date.present? %>
          <tr>
            <td class='k'>Work completed</td>
            <td class='v'><%= estimate.work_completion_date.strftime('%d %B %Y') %></td>
          </tr>
        <% end %>
      </table>
    </td>
  </tr>
</table>

<table class='parties <%= 'spacious' unless scope_present %>'>
  <tr>
    <td>
      <%# customer_detail is a has_one and can be absent; the previous
          template dereferenced it unguarded. %>
      <% detail = estimate.customer_detail %>
      <div class='party-label'>Prepared for</div>
      <div class='party-name'>
        <%= detail&.name.presence || estimate.customer&.name %>
      </div>
      <div class='party-detail'>
        <%= [detail&.phone || estimate.customer&.phone,
             detail&.email || estimate.customer&.email].compact_blank.join(' &nbsp; ').html_safe %>
      </div>
    </td>
    <td>
      <div class='party-label'>Service address</div>
      <div class='party-name'><%= estimate.quote_display_address %></div>
    </td>
  </tr>
</table>

<% if scope_of_work.present? %>
  <div class='section'>
    <div class='section-head'>Scope of work</div>
    <p><%= simple_format(scope_of_work, {}, sanitize: true) %></p>
  </div>
<% end %>

<% if inclusions.any? %>
  <div class='section'>
    <div class='section-head'>What's included</div>
    <ul class='scope-list'>
      <% inclusions.each do |line| %>
        <li><span><%= line %></span></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if exclusions.any? %>
  <div class='section'>
    <div class='section-head'>Not included</div>
    <ul class='scope-list exclusions'>
      <% exclusions.each do |line| %>
        <li><span><%= line %></span></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class='section'>
  <div class='section-head'>Pricing</div>
  <%= render 'quotes/pdf/cost_summary',
             estimate: estimate,
             include_method: estimate.invoice&.paid? %>
</div>

<%= render 'quotes/pdf/footer', organization: organization, estimate: estimate %>

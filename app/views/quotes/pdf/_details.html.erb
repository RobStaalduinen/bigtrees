<%# Body copy is editable per organization under Quote Customization; the
    stock wording lives in QuoteContentDefaults. Sanitised on the way out — it
    is user-authored HTML heading into a customer-facing document, so only the
    editor's own small tag set survives. %>
<%= render 'quotes/pdf/cont_header',
           organization: organization,
           estimate: estimate,
           document_title: document_title %>

<h2 class='page-title'>Before we start</h2>

<div class='rich-content'>
  <%= sanitize organization.quote_pre_job_html,
               tags: QuoteContentDefaults::ALLOWED_TAGS,
               attributes: [] %>
</div>

<% if organization.phone_number.present? %>
  <div class='note-box'>
    Questions about any of this before the crew arrives? Call <%= organization.phone_number %>.
  </div>
<% end %>

<%= render 'quotes/pdf/footer', organization: organization, estimate: estimate %>

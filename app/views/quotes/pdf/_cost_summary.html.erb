<% include_method ||= false %>

<%# One description per row. The old template padded to 8 blank rows, which
    is most of why it read as a spreadsheet form; a short quote now simply
    ends earlier. Verified to hold 8 items plus totals on one page. %>
<table class='pricing'>
  <% estimate.costs.order(discount: :asc).each do |cost| %>
    <tr>
      <td class='item <%= 'discount' if cost.discount? %>'><%= cost.description %></td>
      <td class='amount <%= 'credit' if cost.discount? %>'><%= number_to_currency(cost.amount) %></td>
    </tr>
  <% end %>

  <tr class='sum first-sum'>
    <td class='item'>Subtotal</td>
    <td class='amount'><%= number_to_currency(estimate.total_cost.to_f) %></td>
  </tr>
  <tr class='sum'>
    <td class='item'>HST</td>
    <td class='amount'><%= number_to_currency(estimate.hst.to_f) %></td>
  </tr>
</table>

<%# Same fallback as the masthead rule: the stylesheet's maple red when the
    organization has no valid primary_colour. %>
<% accent = estimate.organization.quote_accent_colour %>
<table class='total-band' <%= tag.attributes(style: accent ? "background: #{accent}" : nil) %>>
  <tr>
    <td class='label'>Total</td>
    <td class='value'><%= number_to_currency(estimate.total_cost_with_tax.to_f) %></td>
  </tr>
</table>

<% if include_method && estimate.invoice&.payment_method.present? %>
  <div class='paid-note'>Paid by <%= estimate.invoice.payment_method %></div>
<% end %>
